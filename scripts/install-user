#!/usr/bin/env bash
set -euo pipefail
project_dir="$(cd -- "$(dirname -- "$0")/.." && pwd)"
binary="${1:-$project_dir/target/release/oneaxe-voice-linux}"
[[ -x "$binary" ]] || { echo '缺少客户端可执行文件；先 cargo build --release。' >&2; exit 2; }
for dependency in parec pactl xclip xdotool xprop gsettings; do
  command -v "$dependency" >/dev/null || { echo "缺少依赖：$dependency" >&2; exit 2; }
done
data_dir="${XDG_DATA_HOME:-$HOME/.local/share}"
mkdir -p "$HOME/.local/bin" "$data_dir/applications" "$data_dir/oneaxe-voice-linux/icons" "$data_dir/icons/hicolor/scalable/apps"
install -m 755 "$binary" "$HOME/.local/bin/.oneaxe-voice-linux.next"
mv -f -- "$HOME/.local/bin/.oneaxe-voice-linux.next" "$HOME/.local/bin/oneaxe-voice-linux"
for icon in "$project_dir"/assets/*.svg; do
  [[ -f "$icon" ]] || continue
  install -m 644 "$icon" "$data_dir/oneaxe-voice-linux/icons/"
  install -m 644 "$icon" "$data_dir/icons/hicolor/scalable/apps/"
done
cat > "$data_dir/applications/oneaxe-voice-linux.desktop" <<EOF
[Desktop Entry]
Type=Application
Name=OneAxe Voice Linux
Comment=连接远端语音服务器的轻量听写客户端
Exec="$HOME/.local/bin/oneaxe-voice-linux" --show
Icon=oneaxe-voice-linux
Terminal=false
Categories=AudioVideo;Audio;Utility;
StartupWMClass=oneaxe-voice-linux
EOF
chmod 644 "$data_dir/applications/oneaxe-voice-linux.desktop"
"$HOME/.local/bin/oneaxe-voice-linux" --install-hotkey
command -v update-desktop-database >/dev/null && update-desktop-database "$data_dir/applications" || true
echo "已安装到 $HOME/.local/bin/oneaxe-voice-linux；默认快捷键 F9。"
